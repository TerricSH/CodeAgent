# Model API
API_KEY=
API_BASE_URL=
MODEL_NAME=
MODEL_MAX_CONTEXT_TOKENS=1048576

# Shared PostgreSQL server. Runtime and RAG use separate schemas.
CODEAGENT_POSTGRES_URL=postgresql://codeagent:codeagent@127.0.0.1:5432/codeagent
CODEAGENT_POSTGRES_SCHEMA=codeagent_runtime
CODEAGENT_POSTGRES_MAX_CONNECTIONS=10
CODEAGENT_POSTGRES_CONNECTION_TIMEOUT_MS=5000
RAG_POSTGRES_SCHEMA=codeagent_rag
RAG_POSTGRES_MAX_CONNECTIONS=10

# Optional compatibility aliases. CODEAGENT_POSTGRES_URL is preferred.
# DATABASE_URL=postgresql://codeagent:codeagent@127.0.0.1:5432/codeagent
# RAG_POSTGRES_URL=postgresql://codeagent:codeagent@127.0.0.1:5432/codeagent
