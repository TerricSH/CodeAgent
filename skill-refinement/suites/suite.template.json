{
    "schemaVersion": 2,
    "id": "replace-with-suite-directory-name",
    "templateModel": "vendor@interface/template-model",
    "reflectionModel": "vendor@interface/reflection-model",
    "baseline": ".",
    "skillPath": "seed-skill.md",
    "dataset": {
        "train": [
            { "id": "train-001", "task": "Describe one training task." }
        ],
        "selection": [
            { "id": "selection-001", "task": "Describe one held-out selection task." }
        ],
        "test": [
            { "id": "test-001", "task": "Describe one disjoint held-out test task." }
        ]
    },
    "optimizer": {
        "epochs": 4,
        "rolloutBatchSize": 40,
        "accumulationFactor": 1,
        "reflectionMinibatchSize": 8,
        "mergeBatchSize": 8,
        "analystWorkers": 16,
        "reflectionRounds": 3,
        "shuffleSeed": 42,
        "editBudget": {
            "initial": 4,
            "floor": 2,
            "schedule": "cosine"
        },
        "rejectedBuffer": { "enabled": true, "maxEntries": 20 },
        "slowUpdate": { "enabled": true, "sampleSize": 20 },
        "metaUpdate": { "enabled": true }
    },
    "protectedPaths": [
        "test",
        "package.json",
        "package-lock.json"
    ],
    "evaluation": {
        "command": "npm test",
        "timeoutMs": 120000,
        "reward": {
            "mode": "exit_code",
            "successThreshold": 1
        }
    }
}
